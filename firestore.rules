rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerUid == request.auth.uid; }
    function member() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['user', 'admin']; }
    function admin() { return member() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
      match /messages/{id} {
        allow read: if member() && request.auth.uid == uid;
        allow write: if false;
      }
      match /chat_requests/{id} {
        allow read: if member() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /raw_telematics_logs/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/raw_telematics_logs/$(id)) || owns(resource.data));
      allow list: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && request.resource.data.keys().hasAll(['log', 'ownerUid', 'fileName', 'lineNumber', 'uploadedAt', 'status'])
        && request.resource.data.keys().hasOnly(['log', 'ownerUid', 'fileName', 'lineNumber', 'uploadedAt', 'status'])
        && request.resource.data.log is string
        && request.resource.data.log.size() > 0 && request.resource.data.log.size() <= 10000
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 255
        && request.resource.data.lineNumber is int && request.resource.data.lineNumber > 0
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }
    match /telematics_logs/{id} {
      allow read: if owns(resource.data);
      allow write: if false;
    }
  }
}
