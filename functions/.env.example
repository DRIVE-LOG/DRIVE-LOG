# GMS portal에서 안내하는 OpenAI-compatible base URL과 허용 모델을 입력합니다.
GMS_ENABLED=false
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-4o-mini
# GMS_API_KEY는 운영 환경에서 firebase functions:secrets:set GMS_API_KEY로 저장합니다.
# 에뮬레이터에서는 functions/.secret.local에 GMS_API_KEY=... 를 작성합니다.

# Firebase Hosting의 /api 프록시를 사용할 때만 설정합니다.
# 실제 값은 functions/.env.<projectId> 에 작성하고 Git에 올리지 않습니다.
EXTERNAL_APIS_ENABLED=false
# WEB_FIREBASE_CONFIG={"apiKey":"YOUR_WEB_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_BUCKET","appId":"YOUR_APP_ID"}
# KAKAO_MAP_JAVASCRIPT_KEY=YOUR_PUBLIC_KAKAO_KEY
# 외부 API 활성화 시 KAKAO_MOBILITY_REST_API_KEY와 OPENWEATHER_API_KEY를 Secret Manager에 등록합니다.
