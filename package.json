{
  "name": "telematics-log-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs infotainment/test/*.js",
    "check": "node scripts/check.mjs",
    "package:submission": "node scripts/package-submission.mjs",
    "start:local": "node scripts/build.mjs && node scripts/local.mjs",
    "test:emulator": "node --test tests/emulator/*.test.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "seed:local": "node scripts/seed-local.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^13.0.0",
    "maplibre-gl": "^6.14.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "fflate": "^0.8.2",
    "firebase-tools": "^15.30.0",
    "vite": "^8.3.4"
  }
