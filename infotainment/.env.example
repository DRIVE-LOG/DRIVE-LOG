# Copy this file to .env, then fill in only the four values below.
# Choose one of 5500, 5501, or 5502.
PORT=5501

# Public browser key. Register http://localhost:<PORT> in Kakao Developers.
KAKAO_MAP_JAVASCRIPT_KEY=

# Server-only API keys. Never expose these values to browser code.
KAKAO_MOBILITY_REST_API_KEY=
OPENWEATHER_API_KEY=
